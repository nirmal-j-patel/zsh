    'Z04zgetopt.ztst',
)

test_env_var = {
    'ZTST_verbose': '1',
    'ZTST_exe': nsh_exe_for_tests_only.full_path(),
}

ztst_handler = files('ztst.zsh')[0]
foreach f : test_scripts
    test(
        fs.name(f),
        nsh_exe_for_tests_only,
        args: [
            '+Z',
            '-f',
            ztst_handler.full_path(),
            f.full_path(),
        ],
        env: test_env_var,
        is_parallel: false,
        workdir: meson.project_build_root() / 'Src',
        depends: [nsh_exe_for_tests_only, nsh_dynamic_modules],
    )
endforeach
