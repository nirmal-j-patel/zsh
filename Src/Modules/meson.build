errnames_c = custom_target(
    'errnames.c',
    output: 'errnames.c',
    command: [
        sh,
        meson.project_source_root() / 'build-aux' / 'generate_errnames.sh',
    ],
    env: {
        'CPP': cc.cmd_array(),
        'CPPFLAGS': '-E',
        'sdir': meson.project_source_root() / 'Src' / 'Modules',
    },
    capture: true,
)

errcount_h = custom_target(
    'errcount.h',
    input: errnames_c,
    output: 'errcount.h',
    command: ['grep', 'define.*ERRCOUNT', errnames_c],
    capture: true,
)

curses_keys_h = custom_target(
    'curses_keys.h',
    output: 'curses_keys.h',
    command: [
        sh,
        meson.project_source_root() / 'build-aux' / 'generate_curses_keys.sh',
    ],
    env: {
        'CPP': cc.cmd_array(),
        'CPPFLAGS': '-E',
        'sdir': meson.project_source_root() / 'Src' / 'Modules',
    },
    capture: true,
)

