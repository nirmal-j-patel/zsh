option('pcre', type: 'feature', value: 'auto', description: 'Enable PCRE support')
option('cap', type: 'feature', value: 'auto', description: 'Enable libcap support')
option('gdbm', type: 'feature', value: 'auto', description: 'Enable GDBM support')
option('nsl', type: 'feature', value: 'auto', description: 'Enable libnsl support')
option(
  'iconv',
  type: 'feature',
  value: 'auto',
  description: 'Enable libiconv support',
)
option(
  'maildir_support',
  type: 'feature',
  value: 'auto',
  description: 'Enable maildir support',
)

option(
  'use_suspended',
  type: 'boolean',
  value: true,
  description: 'Use suspended instead of stopped',
)

option(
  'default_histsize',
  type: 'integer',
  value: 30,
  description: 'The default history buffer size in lines',
)

option(
  'default_fcedit',
  type: 'string',
  value: 'vi',
  description: 'The default editor for the fc builtin',
)

option(
  'default_tmpprefix',
  type: 'string',
  value: '/tmp/nsh',
  description: 'The default prefix for temporary files',
)

option(
  'etcdir',
  type: 'string',
  value: '/etc',
  description: 'The default directory for global nsh scripts (or "no" to disable all scripts)',
)

option(
  'nshenv',
  type: 'string',
  value: 'auto',
  description: 'The full pathname of the global nshenv script, "no" to disable, or "auto"',
)

option(
  'nshrc',
  type: 'string',
  value: 'auto',
  description: 'The full pathname of the global nshrc script, "no" to disable, or "auto"',
)

option(
  'nprofile',
  type: 'string',
  value: 'auto',
  description: 'The full pathname of the global nprofile script, "no" to disable, or "auto"',
)

option(
  'nlogin',
  type: 'string',
  value: 'auto',
  description: 'The full pathname of the global nlogin script, "no" to disable, or "auto"',
)

option(
  'nlogout',
  type: 'string',
  value: 'auto',
  description: 'The full pathname of the global nlogout script, "no" to disable, or "auto"',
)

option('locale', type: 'feature', value: 'enabled', description: 'Enable locale')

option(
  'runhelpdir',
  type: 'string',
  value: 'auto',
  description: 'The directory in which to install run-help files ("no" to disable, "auto" for default)',
)

option(
  'fndir',
  type: 'string',
  value: 'auto',
  description: 'The directory in which to install functions ("auto" for default)',
)

option(
  'site_fndir',
  type: 'string',
  value: 'auto',
  description: 'Same for site functions (not version specific) ("auto" for default, "no" to disable)',
)

option(
  'function_subdirs',
  type: 'boolean',
  value: false,
  description: 'Install functions in subdirectories',
)

option(
  'additional_fpath',
  type: 'string',
  value: '',
  description: 'Add comma-separated directories to default function path',
)

option(
  'scriptdir',
  type: 'string',
  value: 'auto',
  description: 'the directory in which to install scripts',
)
option(
  'site-scriptdir',
  type: 'string',
  value: 'auto',
  description: 'same for site scripts (not version specific)',
)

option(
  'custom-patchlevel',
  type: 'string',
  value: '',
  description: 'set a custom ZSH_PATCHLEVEL value',
)

option(
  'max_function_depth',
  type: 'integer',
  value: 500,
  description: 'limit function depth',
)

option(
  'default_readnullcmd',
  type: 'string',
  value: 'more',
  description: 'Pager used when READNULLCMD is not set',
)

# option('dynamic_modules', type: 'feature', value: 'enabled', description: 'Enable dynamically linked modules')

option('dynamic_modules', type: 'feature', value: 'enabled', description: 'Enable dynamically linked modules')

